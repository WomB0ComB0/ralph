#!/usr/bin/env bash
# ci-fails - recent failing CI runs for a repo: <run-id>  <workflow>  [branch]  <url>.
# Feed a run id straight into `ralph triage --fix-ci --run <id>`. Usage: ci-fails [owner/repo] [limit=10]
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/github.sh
# shellcheck disable=SC1091
source "$script_dir/../lib/github.sh"
repo="${1:-}"
if [[ -z "$repo" ]]; then repo=$(ralph_gh_current_repo) || exit $?; fi
limit="${2:-10}"
out=$(ralph_gh_or_exit "listing failing CI runs for $repo" gh run list --repo "$repo" --status failure --limit "$limit" --json databaseId,name,headBranch,url \
  --jq '.[]? | "\(.databaseId)  \(.name // "workflow")  [\(.headBranch // "?")]  \(.url // "")"')
printf '%s
' "$out"
