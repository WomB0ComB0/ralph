#!/usr/bin/env bash
# shellcheck disable=SC2016
# pr-status - compact PR status in a few lines (mergeable, reviewers, UNRESOLVED review threads).
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/github.sh
# shellcheck disable=SC1091
source "$script_dir/../lib/github.sh"
pr="${1:?usage: pr-status <pr> [owner/repo]}"
repo="${2:-}"
if [[ -z "$repo" ]]; then repo=$(ralph_gh_current_repo) || exit $?; fi
owner="${repo%%/*}"; name="${repo##*/}"
out=$(ralph_gh_or_exit "reading PR #$pr status for $repo" gh api graphql \
  -f query='query($o:String!,$n:String!,$pr:Int!){repository(owner:$o,name:$n){pullRequest(number:$pr){state mergeable reviewDecision reviews(first:20){nodes{author{login}}} reviewThreads(first:50){nodes{id isResolved comments(first:1){nodes{path line body}}}}}}}' \
  -F o="$owner" -F n="$name" -F pr="$pr" \
  --jq '.data.repository.pullRequest as $p
    | "PR #'"$pr"' ('"$repo"')  state=\($p.state)  mergeable=\($p.mergeable)  review=\($p.reviewDecision // "-")",
      "reviewers: \([$p.reviews.nodes[].author.login]|unique|join(", ") | if .=="" then "-" else . end)",
      "unresolved: \([$p.reviewThreads.nodes[]|select(.isResolved==false)]|length)",
      ($p.reviewThreads.nodes[]|select(.isResolved==false)
        | "  \(.id)  \(.comments.nodes[0].path // "-"):\(.comments.nodes[0].line // 0)  \(.comments.nodes[0].body | gsub("\n";" ") | .[0:130])")')
printf '%s
' "$out"
