#!/bin/bash
# Periodic public-repo patrol: refresh allowlist, test Synapse, run Ralph triage.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ralph_home="${RALPH_HOME:-$(cd "$script_dir/.." && pwd)}"
ralph_bin="${RALPH_BIN:-$ralph_home/ralph.sh}"
org="${RALPH_ORG:-}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
targets_file="${RALPH_ORG_TARGETS_FILE:-}"
log_dir="${RALPH_ORG_LOG_DIR:-}"
mode="${RALPH_ORG_TRIAGE_MODE:-report}"
synapse_check="${RALPH_ORG_SYNAPSE_CHECK:-1}"
resource_history="${RALPH_ORG_RESOURCE_HISTORY:-1}"
log_retention="${RALPH_ORG_LOG_RETENTION:-48}"
discover_args=()


resource_summary_line() {
    jq -r --arg history "$1" '
      def bytes($b):
        if $b == null then "n/a"
        elif $b >= 1073741824 then (((($b / 1073741824) * 10 | round) / 10) | tostring) + "G"
        elif $b >= 1048576 then (((($b / 1048576) * 10 | round) / 10) | tostring) + "M"
        elif $b >= 1024 then (((($b / 1024) * 10 | round) / 10) | tostring) + "K"
        else ($b | tostring) + "B" end;
      def pct($n): if $n == null then "n/a" else (($n | tostring) + "%") end;
      def n($v): if $v == null then "n/a" else ($v | tostring) end;
      ([.warnings[]?.kind] | any(. == "slope")) as $has_slope
      | (.warnings | length) as $warning_count
      | ([.trend.slope.percent_per_sample[]? | select(. != null)] | max // null) as $max_slope
      | (if $has_slope then "sustained-growth" elif $warning_count > 0 then "warning" else "normal" end) as $band
      | "resource summary: band=\($band) ok=\(.ok) warnings=\($warning_count) disk=\(bytes(.disk.ralph_bytes)) runs=\(.disk.run_dirs) memory=\(pct(.system.memory.used_percent)) load1=\(n(.system.load.load1)) slope_max=\(pct($max_slope))/sample history=\($history)"
    '
}

usage() {
    cat <<'EOF'
Usage: scripts/org-patrol --org ORG [--mode MODE] [--targets-file FILE] [--no-synapse-check] [--no-resource-history]

MODE values:
  report              read-only triage report (default)
  suggest             dry-run triage issue suggestions
  suggest-apply       create/update idempotent triage issues
  fix-ci              dry-run CI autofix plans
  fix-ci-apply        create PRs for latest failing CI runs
  fix-security        dry-run code-scanning autofix plans
  fix-security-apply  create PRs for highest code-scanning alert per repo

The target allowlist is refreshed from public, non-archived org repos before triage.
Set RALPH_ORG instead of --org for scheduled/non-interactive runs.
Resource history is recorded to the patrol log directory by default; set RALPH_ORG_RESOURCE_HISTORY=0 or pass --no-resource-history to disable it.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode) mode="${2:?--mode requires a value}"; shift 2 ;;
        --mode=*) mode="${1#*=}"; shift ;;
        --org) org="${2:?--org requires a value}"; shift 2 ;;
        --org=*) org="${1#*=}"; shift ;;
        --targets-file) targets_file="${2:?--targets-file requires a value}"; shift 2 ;;
        --targets-file=*) targets_file="${1#*=}"; shift ;;
        --include-archived) discover_args+=(--include-archived); shift ;;
        --no-synapse-check) synapse_check=0; shift ;;
        --no-resource-history) resource_history=0; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$org" ]]; then
    echo "--org or RALPH_ORG is required" >&2
    usage >&2
    exit 2
fi
: "${targets_file:=$config_home/ralph/${org}.targets}"
: "${log_dir:=$state_home/ralph/${org}}"

mkdir -p "$log_dir" "$(dirname "$targets_file")"
if [[ "$log_retention" =~ ^[0-9]+$ && "$log_retention" -gt 0 ]]; then
    mapfile -t _old_logs < <(find "$log_dir" -maxdepth 1 -type f -name 'patrol-*.log' -printf '%f\n' 2>/dev/null | sort | head -n -"$log_retention" 2>/dev/null || true)
    for _old_log in "${_old_logs[@]}"; do
        rm -f "$log_dir/$_old_log" 2>/dev/null || true
    done
fi
log_file="$log_dir/patrol-$(date -u +%Y%m%dT%H%M%SZ).log"
exec > >(tee -a "$log_file") 2>&1

printf '[%s] Ralph public-org patrol starting: org=%s mode=%s\n' "$(date -u +%FT%TZ)" "$org" "$mode"
printf 'ralph_home=%s\ntargets_file=%s\nlog_file=%s\n' "$ralph_home" "$targets_file" "$log_file"

"$ralph_home/scripts/org-public-targets" --org "$org" --write "$targets_file" "${discover_args[@]}" >/dev/null
target_count=$(grep -c '^[^#[:space:]].*/[^#[:space:]]' "$targets_file" 2>/dev/null || true)
printf 'refreshed %s public target(s):\n' "${target_count:-0}"
sed 's/^/  - /' "$targets_file"

if [[ "$synapse_check" == "1" ]]; then
    if "$ralph_bin" synapse live-test ralph; then
        printf 'synapse live-test passed\n'
    else
        printf 'WARNING: synapse live-test failed; continuing with GitHub triage\n' >&2
    fi
fi

triage_args=(triage)
case "$mode" in
    report) ;;
    suggest) triage_args+=(--suggest) ;;
    suggest-apply) triage_args+=(--suggest --apply) ;;
    fix-ci) triage_args+=(--fix-ci) ;;
    fix-ci-apply) triage_args+=(--fix-ci --apply) ;;
    fix-security) triage_args+=(--fix-security) ;;
    fix-security-apply) triage_args+=(--fix-security --apply) ;;
    *) echo "invalid RALPH_ORG_TRIAGE_MODE: $mode" >&2; exit 2 ;;
esac

export RALPH_TARGETS_FILE="$targets_file"
export RALPH_SIGNAL_REWRITE_MIN_SECONDS="${RALPH_SIGNAL_REWRITE_MIN_SECONDS:-3600}"
"$ralph_bin" "${triage_args[@]}"
if [[ "$resource_history" == "1" ]]; then
    resource_history_file="${RALPH_RESOURCE_HISTORY_FILE:-$log_dir/resource-history.jsonl}"
    resource_rc=0
    resource_output=$("$ralph_bin" resource report --record-history "$resource_history_file" 2>&1) || resource_rc=$?
    if [[ "$resource_rc" -eq 0 || "$resource_rc" -eq 3 ]]; then
        if command -v jq >/dev/null 2>&1 && jq -e type >/dev/null 2>&1 <<<"$resource_output"; then
            resource_summary_line "$resource_history_file" <<<"$resource_output"
            resource_ok=$(jq -r '.ok' <<<"$resource_output")
            resource_warnings=$(jq -r '.warnings | length' <<<"$resource_output")
            printf 'resource report recorded: ok=%s warnings=%s history=%s\n' "$resource_ok" "$resource_warnings" "$resource_history_file"
        else
            printf 'resource report recorded: history=%s\n' "$resource_history_file"
        fi
    else
        printf 'WARNING: resource report history failed with rc=%s\n%s\n' "$resource_rc" "$resource_output" >&2
    fi
fi

printf '[%s] Ralph public-org patrol complete\n' "$(date -u +%FT%TZ)"
