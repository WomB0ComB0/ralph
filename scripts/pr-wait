#!/usr/bin/env bash
# pr-wait - poll a PR until it has at least one review (or timeout), then print its status.
set -uo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/github.sh
# shellcheck disable=SC1091
source "$script_dir/../lib/github.sh"
pr="${1:?usage: pr-wait <pr> [owner/repo] [max_seconds]}"
repo="${2:-}"
if [[ -z "$repo" ]]; then repo=$(ralph_gh_current_repo) || exit $?; fi
maxs="${3:-180}"
elapsed=0
while (( elapsed < maxs )); do
  rc=0
  revs=$(ralph_gh_capture gh pr view "$pr" --repo "$repo" --json reviews --jq '[.reviews[].author.login]|unique|join(",")') || rc=$?
  if [[ "$rc" -eq 75 ]]; then ralph_gh_fail_message "polling PR #$pr reviews for $repo" "$revs"; exit 75; elif [[ "$rc" -ne 0 ]]; then echo "failed to fetch PR #$pr ($repo) - does it exist? $revs" >&2; exit "$rc"; fi
  [[ -n "$revs" ]] && break
  sleep 15; elapsed=$((elapsed + 15))
done
"$script_dir/pr-status" "$pr" "$repo"
