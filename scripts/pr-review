#!/usr/bin/env bash
# shellcheck disable=SC2016  # $vars in the single-quoted GraphQL queries are GraphQL variables, not shell
# pr-review — full (untruncated) bodies of a PR's UNRESOLVED review comments, for addressing.
# Complements `pr-status` (which truncates). Usage: pr-review <pr> [owner/repo]
set -euo pipefail
pr="${1:?usage: pr-review <pr> [owner/repo]}"
repo="${2:-}"; [[ -n "$repo" ]] || repo=$(gh repo view --json nameWithOwner -q .nameWithOwner) || { echo "not in a GitHub repo; pass owner/repo" >&2; exit 1; }
owner="${repo%%/*}"; name="${repo##*/}"
gh api graphql \
  -f query='query($o:String!,$n:String!,$pr:Int!){repository(owner:$o,name:$n){pullRequest(number:$pr){reviewThreads(first:100){nodes{id isResolved comments(first:1){nodes{author{login} path line body}}}}}}}' \
  -F o="$owner" -F n="$name" -F pr="$pr" \
  --jq '.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved==false) | .comments.nodes[0] as $c
        | "── \($c.path // "-"):\($c.line // 0)  @\($c.author.login // "?")  [\(.id)]\n\($c.body)\n"'
