#!/usr/bin/env bash
# shellcheck disable=SC2016
# pr-review - full bodies of a PR's UNRESOLVED review comments.
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/github.sh
# shellcheck disable=SC1091
source "$script_dir/../lib/github.sh"
pr="${1:?usage: pr-review <pr> [owner/repo]}"
repo="${2:-}"
if [[ -z "$repo" ]]; then repo=$(ralph_gh_current_repo) || exit $?; fi
owner="${repo%%/*}"; name="${repo##*/}"
rc=0
out=$(ralph_gh_capture gh api graphql \
  -f query='query($o:String!,$n:String!,$pr:Int!){repository(owner:$o,name:$n){pullRequest(number:$pr){reviewThreads(first:100){nodes{id isResolved comments(first:1){nodes{author{login} path line body}}}}}}}' \
  -F o="$owner" -F n="$name" -F pr="$pr" \
  --jq '.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved==false) | .comments.nodes[0] as $c
        | "── \($c.path // "-"):\($c.line // 0)  @\($c.author.login // "?")  [\(.id)]\n\($c.body)\n"') || rc=$?
if [[ "$rc" -eq 75 ]]; then ralph_gh_fail_message "reading PR #$pr review comments for $repo" "$out"; exit 75; elif [[ "$rc" -ne 0 ]]; then ralph_gh_fail_message "reading PR #$pr review comments for $repo" "$out"; exit "$rc"; fi
printf '%s\n' "$out"
